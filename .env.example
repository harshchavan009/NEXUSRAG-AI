# NexusRAG Environment Configuration Example
# Copy this file to .env and provide your Gemini or OpenAI API keys

APP_NAME=NexusRAG
ENVIRONMENT=development
DEBUG=false

# Session & Security
SESSION_COOKIE_NAME=nexus_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800

# Database (PostgreSQL for production; defaults to local SQLite if omitted)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusrag

# AI Provider Configuration (Google Gemini API)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here

# OpenAI API (Optional alternative provider)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Default Models (Current Google AI Studio Endpoints)
DEFAULT_EMBEDDING_MODEL=gemini-embedding-2
DEFAULT_GENERATION_MODEL=gemini-3.5-flash-lite
EMBEDDING_DIMENSION=768

# Chunking & RAG Parameters
DEFAULT_CHUNK_SIZE=700
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=8
DEFAULT_FINAL_CONTEXT_K=4
EVIDENCE_SUFFICIENCY_THRESHOLD=0.65
GROUNDEDNESS_THRESHOLD=0.70

